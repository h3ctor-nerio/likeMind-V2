# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=likeminds

# Long random string used to sign login cookies (at least 16 characters)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that can open /admin (review queue, organizer approvals)
ADMIN_EMAILS=admin@likeminds.test

# AI (optional). With OPENAI_API_KEY set, the app uses OpenAI for moderation, translation,
# community-theme summaries, and live voice-to-text when sharing a thought.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-realtime-whisper

# Alternative text provider, used only when OPENAI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Event approval: "flagged" (default) publishes events that pass every automatic check and sends the rest
# to moderators. "all" holds every new event until a moderator approves it on the Review page.
EVENT_APPROVAL=flagged
